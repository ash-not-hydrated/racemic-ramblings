---
import Layout from "../layouts/Layout.astro";

const posts = Object.values(
  import.meta.glob("./*.md", { eager: true })
);
---

<Layout title="racemic ramblings">

<div id="content">

    <aside class="sidebar">

        <div class="title">about</div>

        cant these atoms just bond amongst themselves?
        why do they have to ramble on about it?

        <div class="divider"></div>

        <div class="title">currently..</div>

        <b>listening</b> nothing<br />
        <b>reading</b> nothing<br />
        <b>watching</b> something

    </aside>

    <main>

        <div class="main-title">
            posts
        </div>

        welcome to the world of no selectivity.
        my racemic thoughts are going to be archived here.

        <div class="divider"></div>

        <div class="main-title">
            latest posts
        </div>

        <ul>
            {posts.map((post) => (
                <li>
                    <a href={post.url}>
                        → {post.frontmatter.title}
                    </a>
                </li>
            ))}
        </ul>

    </main>

    <aside class="sidebar">

        <div class="title">elsewhere</div>

        <a href="https://github.com/ash-not-hydrated">
            github.
        </a><br />

        <a href="#">
            bluesky.
        </a><br />

        <a href="#">
            tumblr.
        </a>

    </aside>

</div>

</Layout>